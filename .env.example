# Atlas environment — copy to .env.local and fill in.

# Anthropic (server-side only — never exposed to the client)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# FHIR sandbox (HAPI public R4 — open, no key, supports read + write)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4

# Pinned synthetic demo patient (set in Phase 1, TASK-012)
DEMO_PATIENT_ID=

# Flip to true to use the local mock FHIR server (Phase 3 fallback)
NEXT_PUBLIC_USE_MOCK_FHIR=false

# Azure Document Intelligence (OCR) — server-side only
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=
